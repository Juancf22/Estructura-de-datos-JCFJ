package tareauno;

public class Producto {
    int codigo;
    String nombre;
    double precio;
    int cantidad;

    public Producto(int codigo, String nombre, double precio, int cantidad) {
        this.codigo = codigo;
        this.nombre = nombre;
        this.precio = precio;
        this.cantidad = cantidad;
    }

    @Override
    public String toString() {
        return "Código: " + codigo + ", Nombre: " + nombre + ", Precio: $" + precio + ", Cantidad: " + cantidad;
    }
}
package tareauno;

import java.util.ArrayList;
import java.util.Scanner;

public class GestionProductos {

    
    public static Producto buscarPorCodigo(ArrayList<Producto> productos, int codigoBusqueda) {
        for (Producto producto : productos) {
            if (producto.codigo == codigoBusqueda) {
                return producto;
            }
        }
        return null;
    }

    
    public static void ordenarPorPrecio(ArrayList<Producto> productos) {
        int n = productos.size();
        for (int i = 1; i < n; i++) {
            Producto key = productos.get(i);
            int j = i - 1;

            while (j >= 0 && productos.get(j).precio > key.precio) {
                productos.set(j + 1, productos.get(j));
                j = j - 1;
            }
            productos.set(j + 1, key);
        }
    }

    
    public static void ordenarPorCantidad(ArrayList<Producto> productos) {
        int n = productos.size();
        for (int i = 1; i < n; i++) {
            Producto key = productos.get(i);
            int j = i - 1;

            while (j >= 0 && productos.get(j).cantidad > key.cantidad) {
                productos.set(j + 1, productos.get(j));
                j = j - 1;
            }
            productos.set(j + 1, key);
        }
    }

    public static void main(String[] args) {

        ArrayList<Producto> productos = new ArrayList<>();
        productos.add(new Producto(3005, "Café", 3500.00, 10));
        productos.add(new Producto(1205, "Fresas con crema", 9200.00, 5));
        productos.add(new Producto(2002, "Waffles", 13500.00, 8));
        productos.add(new Producto(4012, "Crepe", 18000.00, 12));

        Scanner scanner = new Scanner(System.in);

        
        System.out.println("Seleccione el criterio de ordenamiento:");
        System.out.println("1. Ordenar por Precio");
        System.out.println("2. Ordenar por Cantidad");
        int opcion = scanner.nextInt();

        if (opcion == 1) {
            ordenarPorPrecio(productos);
            System.out.println("\nProductos ordenados por precio:");
        } else if (opcion == 2) {
            ordenarPorCantidad(productos);
            System.out.println("\nProductos ordenados por cantidad:");
        } else {
            System.out.println("Opción no válida. Mostrando productos sin ordenar.");
        }

        
        for (Producto producto : productos) {
            System.out.println(producto);
        }

        
        System.out.print("\nIngrese el código del producto que desea buscar: ");
        int codigoBusqueda = scanner.nextInt();

        
        Producto productoEncontrado = buscarPorCodigo(productos, codigoBusqueda);

        
        if (productoEncontrado != null) {
            System.out.println("\nProducto encontrado: " + productoEncontrado);
        } else {
            System.out.println("\nProducto con código " + codigoBusqueda + " no encontrado.");
        }

        scanner.close();
    }
}
