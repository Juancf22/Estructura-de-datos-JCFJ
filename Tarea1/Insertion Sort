package tareauno;

import java.util.Scanner;

class Producto {
    int codigo;
    double precio;
    String nombre;

    public Producto(int codigo, double precio, String nombre) {
        this.codigo = codigo;
        this.precio = precio;
        this.nombre = nombre;
    }

    @Override
    public String toString() {
        return "Código: " + codigo + ", Nombre: " + nombre + ", Precio: $" + precio;
    }
}

public class OrdenamientoInsercion {

    // Algoritmo de ordenamiento por inserción
    public static void ordenarPorInsercion(Producto[] productos) {
        int n = productos.length;
        for (int i = 1; i < n; i++) {
            Producto key = productos[i];
            int j = i - 1;

            // Mover elementos mayores que key una posición adelante
            while (j >= 0 && productos[j].codigo > key.codigo) {
                productos[j + 1] = productos[j];
                j = j - 1;
            }
            productos[j + 1] = key;
        }
    }

    // Búsqueda lineal de un producto por código
    public static Producto buscarPorCodigo(Producto[] productos, int codigoBusqueda) {
        for (Producto producto : productos) {
            if (producto.codigo == codigoBusqueda) {
                return producto;
            }
        }
        return null;
    }

    public static void main(String[] args) {
        // Crear un array de productos
        Producto[] productos = {
            new Producto(3005, 3500.00, "Café"),
            new Producto(1205, 9200.00, "Fresas con crema"),
            new Producto(2002, 13500.00, "Waffles"),
            new Producto(4012, 18000.00, "Crepe")
        };

        // Ordenar los productos usando inserción
        ordenarPorInsercion(productos);

        // Mostrar productos ordenados
        System.out.println("Productos ordenados:");
        for (Producto producto : productos) {
            System.out.println(producto);
        }

        // Crear el objeto Scanner para leer la entrada del usuario
        Scanner scanner = new Scanner(System.in);

        // Pedir al usuario que ingrese un código de producto para buscar
        System.out.print("\nIngrese el código del producto que desea buscar: ");
        int codigoBusqueda = scanner.nextInt(); // Leer el código ingresado

        // Realizar la búsqueda lineal por código
        Producto productoEncontrado = buscarPorCodigo(productos, codigoBusqueda);

        // Mostrar el resultado de la búsqueda
        if (productoEncontrado != null) {
            System.out.println("\nProducto encontrado: " + productoEncontrado);
        } else {
            System.out.println("\nProducto con código " + codigoBusqueda + " no encontrado.");
        }

        // Cerrar el scanner
        scanner.close();
    }
}
