class Productos {
    int codigo;
    double precio;
    String nombre;

    // Constructor
    public Productos(int codigo, double precio, String nombre) {
        this.codigo = codigo;
        this.precio = precio;
        this.nombre = nombre;
    }

    @Override
    public String toString() {
        return "{nombre: " + nombre + ", codigo: " + codigo + ", precio: " + precio + "}";
    }
}
import java.util.Arrays;

public class OrdenamientoBurbuja {
    
    public static void ordenarPorBurbuja(Productos[] productos) {
        int n = productos.length;
        
        
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n - i - 1; j++) {
               
                if (productos[j].codigo > productos[j + 1].codigo) {
                    Productos temp = productos[j];
                    productos[j] = productos[j + 1];
                    productos[j + 1] = temp;
                } 
               
                else if (productos[j].codigo == productos[j + 1].codigo) {
                    if (productos[j].precio > productos[j + 1].precio) {
                        Productos temp = productos[j];
                        productos[j] = productos[j + 1];
                        productos[j + 1] = temp;
                    }
                }
            }
        }
    }

    public static void main(String[] args) {
     
        Productos[] productos = {
            new Productos(3005, 3.500, "Cafe"),
            new Productos(1205, 9.200, "Fresas con crema"),
            new Productos(2002, 13.500, "Wafles"),
            new Productos(4012, 18.000, "Crepe")
        };
        
      
        ordenarPorBurbuja(productos);

       
        System.out.println(Arrays.toString(productos));
    }
}
class BusquedaPorCodigo {
    
    public static Productos buscarPorCodigo(Productos[] productos, int codigoBuscado) {
        for (Productos producto : productos) {
            if (producto.codigo == codigoBuscado) {
                return producto; 
            }
        }
        return null; 
    }
}
