import java.util.Arrays;
import java.util.Comparator;

class Estudiante implements Comparable<Estudiante> {
    private int id;
    private String nombre;
    private double promedioAcumulado;

    public Estudiante(int id, String nombre, double promedioAcumulado) {
        this.id = id;
        this.nombre = nombre;
        this.promedioAcumulado = promedioAcumulado;
    }

    public int getId() {
        return id;
    }

    public String getNombre() {
        return nombre;
    }

    public double getPromedioAcumulado() {
        return promedioAcumulado;
    }

    @Override
    public int compareTo(Estudiante otro) {
        return Double.compare(this.promedioAcumulado, otro.promedioAcumulado);
    }

    @Override
    public String toString() {
        return "ID: " + id + ", Nombre: " + nombre + ", Promedio: " + promedioAcumulado;
    }
}

class ComparadorPromedio implements Comparator<Estudiante> {
    @Override
    public int compare(Estudiante e1, Estudiante e2) {
        return Double.compare(e2.getPromedioAcumulado(), e1.getPromedioAcumulado());
    }
}

public class MatriculaHonor {
    private static Estudiante[] estudiantes = new Estudiante[100];
    private static int contador = 0;

    public static void agregarEstudiante(int id, String nombre, double promedio) {
        if (contador < estudiantes.length) {
            estudiantes[contador++] = new Estudiante(id, nombre, promedio);
        }
    }

    public static int busquedaBinariaIterativa(double nota) {
        Arrays.sort(estudiantes, 0, contador);
        int inicio = 0, fin = contador - 1;
        while (inicio <= fin) {
            int medio = inicio + (fin - inicio) / 2;
            if (estudiantes[medio].getPromedioAcumulado() == nota)
                return medio;
            else if (estudiantes[medio].getPromedioAcumulado() < nota)
                inicio = medio + 1;
            else
                fin = medio - 1;
        }
        return -1;
    }

    public static int busquedaBinariaRecursiva(double nota, int inicio, int fin) {
        if (inicio > fin)
            return -1;
        int medio = inicio + (fin - inicio) / 2;
        if (estudiantes[medio].getPromedioAcumulado() == nota)
            return medio;
        else if (estudiantes[medio].getPromedioAcumulado() < nota)
            return busquedaBinariaRecursiva(nota, medio + 1, fin);
        else
            return busquedaBinariaRecursiva(nota, inicio, medio - 1);
    }

    public static int contarMatriculaHonor() {
        int count = 0;
        for (int i = 0; i < contador; i++) {
            if (estudiantes[i].getPromedioAcumulado() >= 4.5) {
                count++;
            }
        }
        return count;
    }

    public static void main(String[] args) {
        agregarEstudiante(1, "Juan", 4.8);
        agregarEstudiante(2, "Ana", 4.9);
        agregarEstudiante(3, "Carlos", 4.6);
        agregarEstudiante(4, "María", 4.5);
        agregarEstudiante(5, "Pedro", 4.4);
        
        Arrays.sort(estudiantes, 0, contador);
        
        System.out.println("Número de estudiantes con matrícula de honor: " + contarMatriculaHonor());
        
        double buscarNota = 4.6;
        int resultadoIterativo = busquedaBinariaIterativa(buscarNota);
        System.out.println("Búsqueda iterativa: " + (resultadoIterativo != -1 ? estudiantes[resultadoIterativo] : "No encontrado"));
        
        int resultadoRecursivo = busquedaBinariaRecursiva(buscarNota, 0, contador - 1);
        System.out.println("Búsqueda recursiva: " + (resultadoRecursivo != -1 ? estudiantes[resultadoRecursivo] : "No encontrado"));
    }
}
